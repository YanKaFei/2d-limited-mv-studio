  "rules": {
    "formula": "[景别] + [角度] + [运动 + 方向 + 速度 + 与主体的关系] + [主体与动作] + [这个镜头要揭示什么]",
    "static_lock": {
      "en": "The camera is entirely motionless for the duration of the scene, with movement only occurring from the subject.",
      "zh": "整段镜头，摄影机完全静止不动；画面里只有主体在动。",
      "why": "实测结论：固定镜头是最难落地的一条，模型天生要制造运动，尤其在大远景上会自己飘。必须用自然语言把锁再上一遍。"
    },
    "dont_stack_verbs": {
      "en": "Describe what enters or gets revealed at each phase instead of stacking movement verbs.",
      "zh": "不要堆动词（「环绕 + 推近 + 上升」），改成分阶段描述画面里出现了什么。"
    },
    "subject_camera_relationship": {
      "en": "Always join the camera to the subject with a relationship verb.",
      "zh": "必须写清相机与主体的关系，否则模型会让两个运动各走各的——表现为抖动、人物像在飘。"
    },
    "dolly_is_not_zoom": {
      "en": "Dolly moves the camera (background shifts); zoom magnifies the lens (no perspective change).",
      "zh": "推轨＝机位移动、背景随之变化；变焦＝镜头放大、透视不变。2D 里变焦＝放大原画，推轨＝多层视差，两者是不同的事。"
    },
    "no_3d_language": {
      "zh": "禁止 3D 运镜词（3D orbit / drone / FPV / fly-through / spiral）。校验器会拦。"
    },
    "purpose_required": {
      "zh": "每个镜头都要能回答「这一下要揭示什么」。只是换个景别 → 用运镜，不要切。"
    }
  }
}
