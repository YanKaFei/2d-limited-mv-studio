{
  "meta": {
    "name": "运镜库",
    "version": "0.2.0",
    "source": "骨架取自 MiniMax H3 官方运镜词表；风格兼容性取自 art-aesthetic-vault 各流派卡的『五、AI 视频层』",
    "rule": "写进提示词时，必须用 official_terms 里的官方词，不能只写中文描述。复合运镜要写明两个词『同时进行』。",
    "families": [
      "固定",
      "推拉",
      "摇移",
      "升降",
      "环绕",
      "翻滚",
      "手持",
      "复合"
    ],
    "layers": [
      "shot_size",
      "angle",
      "camera(官方运动词)",
      "framing",
      "focus"
    ],
    "provenance": {
      "official_terms": "MiniMax H3 官方运镜词表（唯一被模型承认的运动词）",
      "shot_size/angle/composition/focus": "取自两个公开的摄影参考：Runway 的 AI camera prompts 参考表（help.runwayml.com / runway.com/resources/ai-camera-prompts）与 patipanpeel/alt-cinematography-reference 的 content.json。",
      "moves_2d": "2D 动画工业术语（摄影台 rostrum / 多层摄影 multiplane / 赛璐璐滑动 / 套印偏移），外加本技能为「平面感」补的几招。",
      "why_layered": "H3 只认官方那 20 个运动词。所以丰富角度不能靠编新词，而是把「景别 / 角度 / 构图 / 焦」做成**独立于运动词**的层，用自然语言写，最后仍然只把运动交给官方词表。",
      "verified": "每个电影术语都在 cinematic_to_official 里映射回官方词；tests/test_mvstudio.py::TestCameraEnrichment 会强制这条不变量。"
    }
  },
  "cameras": [
    {
      "id": "static",
      "name_cn": "固定镜头",
      "official_terms": [
        "Static Shot"
      ],
      "family": "固定",
      "speed": "无",
      "mood": [
        "安静",
        "庄重",
        "冷感",
        "凝视"
      ],
      "note": "全片最省也最容易被忽略的一档。该不动的时候不动，比乱运镜高级。",
      "beat_use": "不需要卡点，整镜保持",
      "forbidden_for_styles": []
    },
    {
      "id": "push_in",
      "name_cn": "机位推进",
      "official_terms": [
        "Push In"
      ],
      "family": "推拉",
      "speed": "慢",
      "mood": [
