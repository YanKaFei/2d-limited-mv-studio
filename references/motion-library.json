{
  "meta": {
    "name": "人物动作库",
    "version": "0.1.0",
    "purpose": "表现不同音乐风格的角色动作。每个动作的 body 字段是可直接写进提示词的中文，不用二次改写。",
    "organizing_principle": "按【音乐风格】分类，不按舞种。同一个人物在不同曲风里要换一整套身体逻辑，而不是换几个动作。",
    "music_styles": [
      "儿歌可爱",
      "抒情慢歌",
      "电子舞曲",
      "古风国风",
      "爵士摇摆",
      "摇滚力量",
      "民谣田园"
    ],
    "fields": {
      "body": "可直接入词的中文身体描述",
      "beats": "占几拍（4/4 拍；按你歌曲的实际拍长换算）",
      "intensity": "1=轻 2=中 3=大",
      "music_styles": "适用曲风",
      "style_avoid": "在这些画风里会显得别扭，不要用",
      "lyric_fit": "适合搭配的歌词意象"
    },
    "note_project_specific_removed": "原本包含四条某个具体项目（儿歌）专用的蛙类动作，已移除——那是项目私有内容。曲风「儿歌可爱」仍保留通用动作。"
  },
